DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SSL Doğrulama (AutoSSL) klasörüne dokunma, geçmesine izin ver
  RewriteRule ^\.well-known/ - [L,NC]

  # Diğer her şeyi React'e (index.html) yönlendir
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ────────────────────────────────────────────────────────────────────
# ÖNBELLEK (CACHE) AYARLARI
# Sorun: Yeni build sonrası site "ilk açılışta eski, yenileyince yeni"
#        görünüyordu. Sebebi tarayıcının eski index.html'i önbellekten
#        sunması. Çözüm: index.html'i ASLA önbelleğe alma; böylece her
#        ziyarette güncel JS dosyasının adı okunur ve son sürüm yüklenir.
# JS/CSS dosyalarının adı her build'de değiştiği (hash) için onları uzun
# süre önbelleğe almak güvenlidir ve siteyi hızlandırır.
# ────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # index.html her zaman taze gelsin
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hash'li statik dosyalar kalıcı önbelleğe alınabilir (adı her build'de değişir)
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>